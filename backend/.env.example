########################################
# Backend .env example
########################################

PORT=3001
NODE_ENV=development

# Optional: listen address. Default 0.0.0.0 so http://<LAN-IP>:3001 works for Expo on a phone.
# BIND_HOST=127.0.0.1

# Supabase (from Supabase dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API key (required for recipe generation)
OPENAI_API_KEY=sk-your-openai-api-key

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional: error tracking (install @sentry/node and initialize in server entry if set)
# SENTRY_DSN=
